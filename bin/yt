#!/bin/bash

# ytdlp-tui.sh - Polished TUI wrapper for yt-dlp audio downloads

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Default directories
MUSIC_DIR="$HOME/Music"
CONFIG_DIR="$HOME/.config/ytdlp-tui"

# UI mode: fzf, whiptail, or basic
UI_MODE=""

# Check available UI tools
detect_ui() {
    if command -v fzf &> /dev/null; then
        UI_MODE="fzf"
        echo -e "${GREEN}Using fzf for interface${NC}"
    elif command -v whiptail &> /dev/null; then
        UI_MODE="whiptail"
        echo -e "${YELLOW}Using whiptail for interface${NC}"
    else
        UI_MODE="basic"
        echo -e "${BLUE}Using basic interface${NC}"
    fi
}

# Check dependencies
check_dependencies() {
    if ! command -v yt-dlp &> /dev/null; then
        echo -e "${RED}Error: yt-dlp is not installed${NC}"
        echo "Install from: https://github.com/yt-dlp/yt-dlp"
        exit 1
    fi
}

# Setup directories
setup_directories() {
    mkdir -p "$MUSIC_DIR"
    mkdir -p "$CONFIG_DIR"
}

# Show fancy header
show_header() {
    clear
    echo -e "${PURPLE}"
    cat << "HEADER"
╔══════════════════════════════════════════════════════════╗
║                   🎵 YouTube-DL Audio TUI                ║
║                     Audio Downloader                     ║
╚══════════════════════════════════════════════════════════╝
HEADER
    echo -e "${NC}"
}

# Get URL with fancy prompt
get_url() {
    show_header
    echo -e "${CYAN}📥 Enter Video/Playlist URL${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${YELLOW}Supported: YouTube, SoundCloud, Bandcamp, etc.${NC}"
    echo
    read -p "$(echo -e "${GREEN}🔗 URL: ${NC}")" url
    
    if [ -z "$url" ]; then
        echo -e "${RED}❌ URL cannot be empty!${NC}"
        sleep 2
        get_url
    fi
}

# Select format based on UI mode
select_format() {
    case $UI_MODE in
        "fzf")
            select_format_fzf
            ;;
        "whiptail")
            select_format_whiptail
            ;;
        "basic")
            select_format_basic
            ;;
    esac
}

select_format_fzf() {
    show_header
    echo -e "${CYAN}🎼 Select Audio Format${NC}"
    echo -e "${BLUE}=========================================${NC}"
    
    format=$(printf "mp3\tMP3 format (most compatible)\nm4a\tM4A format (Apple devices)\nopus\tOpus format (high quality)\nflac\tFLAC format (lossless)\nwav\tWAV format (uncompressed)" | fzf --height=40% --header="Select audio format:" --delimiter=$'\t' --with-nth=1,2 | cut -f1)
    
    if [ -z "$format" ]; then
        echo -e "${RED}No format selected, using mp3${NC}"
        format="mp3"
    fi
}

select_format_whiptail() {
    format=$(whiptail --title "Select Audio Format" --menu "Choose download format:" 15 50 5 \
        "mp3" "MP3 format (most compatible)" \
        "m4a" "M4A format (Apple devices)" \
        "opus" "Opus format (high quality)" \
        "flac" "FLAC format (lossless)" \
        "wav" "WAV format (uncompressed)" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ] || [ -z "$format" ]; then
        format="mp3"
    fi
}

select_format_basic() {
    show_header
    echo -e "${CYAN}🎼 Select Audio Format${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo
    echo -e "  ${GREEN}1${NC}) ${BOLD}mp3${NC}  - MP3 format (most compatible)"
    echo -e "  ${GREEN}2${NC}) ${BOLD}m4a${NC}  - M4A format (Apple devices)"
    echo -e "  ${GREEN}3${NC}) ${BOLD}opus${NC} - Opus format (high quality)"
    echo -e "  ${GREEN}4${NC}) ${BOLD}flac${NC} - FLAC format (lossless)"
    echo -e "  ${GREEN}5${NC}) ${BOLD}wav${NC}  - WAV format (uncompressed)"
    echo
    
    while true; do
        read -p "$(echo -e "${GREEN}🎵 Select format (1-5): ${NC}")" format_choice
        
        case $format_choice in
            1) format="mp3"; break ;;
            2) format="m4a"; break ;;
            3) format="opus"; break ;;
            4) format="flac"; break ;;
            5) format="wav"; break ;;
            *) echo -e "${RED}❌ Invalid choice! Please enter 1-5${NC}" ;;
        esac
    done
}

# Check if URL is playlist
check_playlist() {
    if [[ "$url" == *"list="* ]] || [[ "$url" == *"playlist"* ]]; then
        return 0
    else
        return 1
    fi
}

# Get playlist items
get_playlist_items() {
    echo -e "${YELLOW}📋 Fetching playlist info...${NC}"
    playlist_info=$(yt-dlp --flat-playlist --print "%(title)s" --print "%(duration)s" --print "%(uploader)s" "$url" 2>/dev/null)
    
    if [ $? -ne 0 ] || [ -z "$playlist_info" ]; then
        return 1
    fi
    
    # Parse into arrays
    IFS=$'\n' read -d '' -r -a titles <<< "$(echo "$playlist_info" | awk 'NR % 3 == 1')"
    IFS=$'\n' read -d '' -r -a durations <<< "$(echo "$playlist_info" | awk 'NR % 3 == 2')"
    IFS=$'\n' read -d '' -r -a uploaders <<< "$(echo "$playlist_info" | awk 'NR % 3 == 0')"
    
    return 0
}

# Select playlist items based on UI mode
select_playlist_items() {
    case $UI_MODE in
        "fzf")
            select_playlist_items_fzf
            ;;
        "whiptail")
            select_playlist_items_whiptail
            ;;
        "basic")
            select_playlist_items_basic
            ;;
    esac
}

select_playlist_items_fzf() {
    show_header
    echo -e "${CYAN}🎵 Select Playlist Items${NC}"
    echo -e "${BLUE}=========================================${NC}"
    
    # Prepare data for fzf
    > /tmp/playlist_items.txt
    for i in "${!titles[@]}"; do
        duration=${durations[$i]:-"Unknown"}
        uploader=${uploaders[$i]:-"Unknown"}
        printf "%-3s %-60s %-8s %s\n" "$((i+1))" "${titles[$i]}" "$duration" "$uploader" >> /tmp/playlist_items.txt
    done
    
    selected=$(cat /tmp/playlist_items.txt | fzf --multi --height=80% --header="Select videos (Tab to select, Enter to confirm)" | awk '{print $1}')
    
    if [ -z "$selected" ]; then
        echo -e "${YELLOW}No items selected, downloading all${NC}"
        download_entire_playlist
        return 1
    fi
    
    # Convert to comma-separated list
    selection_str=$(echo "$selected" | tr '\n' ',' | sed 's/,$//')
    download_selected_videos "$selection_str"
}

select_playlist_items_whiptail() {
    # Build whiptail menu items
    menu_items=()
    for i in "${!titles[@]}"; do
        menu_items+=("$((i+1))" "${titles[$i]:0:50}")
    done
    
    selected=$(whiptail --title "Select Videos" --checklist "Choose videos to download:" 20 60 10 "${menu_items[@]}" 3>&1 1>&2 2>&3)
    
    if [ $? -ne 0 ] || [ -z "$selected" ]; then
        echo -e "${YELLOW}No items selected, downloading all${NC}"
        download_entire_playlist
        return 1
    fi
    
    # Parse whiptail output and convert to comma-separated
    selection_str=$(echo "$selected" | sed 's/"//g' | sed 's/ /,/g')
    download_selected_videos "$selection_str"
}

select_playlist_items_basic() {
    show_header
    echo -e "${CYAN}🎵 Playlist Items${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo
    
    for i in "${!titles[@]}"; do
        duration=${durations[$i]:-"Unknown"}
        echo -e "  ${GREEN}$((i+1))${NC}) ${titles[$i]}"
        echo -e "      ${BLUE}⏱ ${duration}s${NC} | ${PURPLE}👤 ${uploaders[$i]}${NC}"
    done
    
    echo
    echo -e "${YELLOW}Enter video numbers (e.g., 1 3 5) or 'all' for everything:${NC}"
    read -p "$(echo -e "${GREEN}🎯 Selection: ${NC}")" selection
    
    if [ "$selection" = "all" ]; then
        download_entire_playlist
    else
        # Convert space-separated to comma-separated
        selection_str=$(echo "$selection" | tr ' ' ',')
        download_selected_videos "$selection_str"
    fi
}

# Download functions
download_single() {
    show_header
    echo -e "${CYAN}🚀 Starting Download${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${GREEN}📁 Location:${NC} $MUSIC_DIR"
    echo -e "${GREEN}🎵 Format:${NC} $format"
    echo -e "${GREEN}🔗 URL:${NC} $url"
    echo
    echo -e "${YELLOW}⬇️  Downloading...${NC}"
    echo "──────────────────────────────────────────────────"
    
    cd "$MUSIC_DIR"
    yt-dlp -x \
        --audio-format "$format" \
        --audio-quality 0 \
        --embed-metadata \
        -o "%(title)s.%(ext)s" \
        "$url"
    
    handle_download_result
}

download_entire_playlist() {
    show_header
    echo -e "${CYAN}🚀 Downloading Entire Playlist${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${GREEN}📁 Location:${NC} $MUSIC_DIR"
    echo -e "${GREEN}🎵 Format:${NC} $format"
    echo -e "${GREEN}🔗 URL:${NC} $url"
    echo
    echo -e "${YELLOW}⬇️  Downloading ${#titles[@]} videos...${NC}"
    echo "──────────────────────────────────────────────────"
    
    cd "$MUSIC_DIR"
    yt-dlp -x \
        --audio-format "$format" \
        --audio-quality 0 \
        --embed-metadata \
        -o "%(playlist_title)s/%(title)s.%(ext)s" \
        "$url"
    
    handle_download_result
}

download_selected_videos() {
    local selection=$1
    show_header
    echo -e "${CYAN}🚀 Downloading Selected Videos${NC}"
    echo -e "${BLUE}=========================================${NC}"
    echo -e "${GREEN}📁 Location:${NC} $MUSIC_DIR"
    echo -e "${GREEN}🎵 Format:${NC} $format"
    echo -e "${GREEN}🎯 Selected:${NC} $selection"
    echo
    echo -e "${YELLOW}⬇️  Downloading...${NC}"
    echo "──────────────────────────────────────────────────"
    
    cd "$MUSIC_DIR"
    yt-dlp -x \
        --audio-format "$format" \
        --audio-quality 0 \
        --embed-metadata \
        --playlist-items "$selection" \
        -o "%(title)s.%(ext)s" \
        "$url"
    
    handle_download_result
}

handle_download_result() {
    local result=$?
    echo
    echo "──────────────────────────────────────────────────"
    if [ $result -eq 0 ]; then
        echo -e "${GREEN}✅ Download completed successfully!${NC}"
        echo -e "${BLUE}📁 Files saved to: $MUSIC_DIR${NC}"
    else
        echo -e "${RED}❌ Download failed with error code: $result${NC}"
    fi
}

# Continue prompt
continue_prompt() {
    echo
    echo -e "${BLUE}=========================================${NC}"
    read -p "$(echo -e "${GREEN}🔄 Download another? (y/N): ${NC}")" continue
    
    case $continue in
        [Yy]* ) return 0 ;;
        * ) return 1 ;;
    esac
}

# Main function
main() {
    detect_ui
    check_dependencies
    setup_directories
    
    while true; do
        get_url
        select_format
        
        if check_playlist; then
            if get_playlist_items; then
                select_playlist_items
            else
                echo -e "${RED}❌ Failed to fetch playlist info${NC}"
                echo -e "${YELLOW}Trying to download as single video...${NC}"
                download_single
            fi
        else
            download_single
        fi
        
        if ! continue_prompt; then
            echo -e "${CYAN}👋 Thanks for using ytdlp-tui!${NC}"
            clear
            break
        fi
    done
}

# Handle Ctrl+C gracefully
trap 'echo -e "\n${RED}👋 Exiting...${NC}"; exit 0; clear' INT

# Run main function
main
